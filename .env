# Selects which database fragment `docker compose` loads, so a bare `docker compose up` works
# without extra -f flags. bench.sh does NOT rely on this: it passes both -f flags explicitly,
# because --env-file replaces this file rather than adding to it, which would leave the base
# compose loaded on its own and bring up a stack with no database at all.
COMPOSE_FILE=docker-compose.yaml:docker-compose.${DB_BACKEND:-timescaledb}.yaml
